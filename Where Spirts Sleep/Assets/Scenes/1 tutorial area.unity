  m_EditorClassIdentifier: 
  popupPanel: {fileID: 420662259}
  popupText: {fileID: 724532184}
  keyShown: 1
  openKey: 101
  closeKey: 113
  message: "O, w\u0119drowcze, jam sarna, co dawniej zwiastowa\u0142a urodzaj i spok\xF3j
    tych p\xF3l. Lecz teraz ziemia \u0142ka \u2014 zbo\u017Ce usycha, a plony bledn\u0105.
    Bacz, podr\xF3\u017Cniku, bo zb\xF3j tu grasuje \u2014 cie\u0144 mroczny, co
    pok\xF3j kradnie i w\u0119dr\xF3wcom zgub\u0119 niesie. Je\u015Bli chcesz dalej
    kroczy\u0107 i przeszkody przeskakiwa\u0107, zdob\u0105d\u017A dar podw\xF3jnego
    skoku \u2014 to mocy klucz, co z ziemi si\u0142\u0119 czerpie."
  animator: {fileID: 0}
